---
layout: base.njk
schemaType: credential
ogType: article
pagination:
  data: certificates
  size: 1
  alias: certificate
  # Without this Eleventy adds only the first paginated page to collections.all,
  # which would leave every certificate but one out of sitemap.xml.
  addAllPagesToCollections: true
permalink: "/certificates/{{ certificate.id }}/"
---

<article class="cert-detail">
  <nav aria-label="Breadcrumb" class="breadcrumb">
    <ol>
      <li><a href="{{ '/' | url }}">{{ profile.name }}</a></li>
      <li><a href="{{ '/certificates/' | url }}">Certificates</a></li>
      <li aria-current="page">{{ certificate.title }}</li>
    </ol>
  </nav>

  <header>
    <h1>{{ certificate.title }}</h1>
    <p class="issuer">Issued by {{ certificate.issuer }} to {{ profile.name }}</p>
    {% if certificate.isExpired %}<p class="notice">The validity period stated on this credential has ended.</p>{% endif %}
  </header>

  <section aria-labelledby="details-heading">
    <h2 id="details-heading">Credential details</h2>
    <dl class="facts">
      <dt>Issuing organization</dt><dd>{{ certificate.issuer }}</dd>
      {% if certificate.issued %}<dt>Date issued</dt><dd><time datetime="{{ certificate.issued.iso }}">{{ certificate.dateIssued | humanDate }}</time></dd>{% endif %}
      {% if certificate.expires %}
      <dt>{{ "Expired on" if certificate.isExpired else "Valid until" }}</dt>
      <dd><time datetime="{{ certificate.expires.iso }}">{{ certificate.dateExpires | humanDate }}</time></dd>
      {% else %}
      <dt>Expiry</dt><dd>No stated expiry date</dd>
      {% endif %}
      {% if certificate.credentialId %}<dt>Credential ID</dt><dd>{{ certificate.credentialId }}</dd>{% endif %}
      {% if certificate.credentialUrl %}<dt>Verify</dt><dd><a href="{{ certificate.credentialUrl }}" rel="external nofollow">{{ certificate.credentialUrl }}</a></dd>{% endif %}
    </dl>
  </section>

  <section aria-labelledby="covers-heading">
    <h2 id="covers-heading">What this credential covers</h2>
    <p>{{ certificate.description }}</p>
  </section>

  {% if certificate.skills.length %}
  <section aria-labelledby="skills-heading">
    <h2 id="skills-heading">Skills evidenced</h2>
    <ul class="skills">
      {%- for skill in certificate.skills %}<li>{{ skill }}</li>{%- endfor %}
    </ul>
  </section>
  {% endif %}

  {% if certificate.certificateImage or certificate.certificateFile %}
  <section aria-labelledby="image-heading">
    <h2 id="image-heading">The certificate</h2>
    {% if certificate.certificateImage %}
    <figure>
      <img src="{{ certificate.certificateImage | url }}"
           alt="Certificate awarded to {{ profile.name }}: {{ certificate.title }}, issued by {{ certificate.issuer }}"
           {% if certificate.certificateImageWidth %}width="{{ certificate.certificateImageWidth }}" height="{{ certificate.certificateImageHeight }}"{% endif %}
           loading="lazy" decoding="async">
      <figcaption>Display-resolution copy. The full-resolution original is deliberately not published.</figcaption>
    </figure>
    {% endif %}
    {% if certificate.certificateFile %}
    <p><a href="{{ certificate.certificateFile | url }}">Open the certificate document</a></p>
    {% endif %}
  </section>
  {% endif %}

  {% if certificate.extractedText %}
  <section aria-labelledby="raw-heading">
    <h2 id="raw-heading">Text read from the certificate</h2>
    <p class="muted">
      Transcribed by a vision model when this entry was created, and kept verbatim so that
      both people and machines can check the summary above against the source.
    </p>
    <blockquote class="extracted"><p>{{ certificate.extractedText }}</p></blockquote>
  </section>
  {% endif %}
</article>
