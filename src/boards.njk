      <div class="panel co-panel">
        <h3><span class="co-step">3</span> Search their vacancies</h3>
        <div class="filter-grid">
          <div class="field s4"><label class="field-label" for="co-words"><i class="fa-solid fa-font" aria-hidden="true"></i>Title words <span class="opt">optional</span></label><input id="co-words" class="control" type="text" placeholder="e.g. Software, Data, Informatik" autocomplete="off"></div>
          <div class="field s4 co-checks"><label class="co-check"><input type="checkbox" id="co-interns" checked> Internships and student roles only</label><label class="co-check"><input type="checkbox" id="co-germany" checked> In Germany only</label></div>
        </div>
        <p class="result-count">Press <b>Search vacancies</b> above for the companies shown, or <b>Vacancies</b> on one row. A company whose platform has a job-board API is asked directly and its postings come with their dates. For the others, links on the careers page that name an internship are listed for you to open.</p>
        <div id="co-results" hidden>
          <p class="result-count" id="co-results-note" role="status" aria-live="polite"></p>
          <ul class="co-jobs" id="co-results-list"></ul>
        </div>
      </div>
    </div>

    <dialog id="co-edit" class="co-dialog">
      <form method="dialog">
        <h3>Edit company</h3>
        <label>Name <input name="name" class="control" required></label>
        <label>Industry <input name="industry" class="control"></label>
        <label>Head office <input name="hq" class="control"></label>
        <label>Employees <input name="employees" class="control" inputmode="numeric"></label>
        <label>Website <input name="website" class="control" type="url" placeholder="https://"></label>
        <label>Careers page <input name="careersUrl" class="control" type="url" placeholder="https://"></label>
        <p class="result-count">A changed address is marked as not checked until you press Check on its row.</p>
        <p class="result-count" id="co-edit-status" role="status"></p>
        <div class="co-dialog-actions">
          <button class="btn btn-sm btn-ghost" value="remove">Remove company</button>
          <button class="btn btn-sm" value="cancel" formnovalidate>Cancel</button>
          <button class="btn btn-sm btn-primary" value="save">Save</button>
        </div>
      </form>
    </dialog>
  </section>

  <section id="feeds" aria-labelledby="feeds-title">
    <div class="section-head reveal">
      <span class="chip-icon"><i class="fa-solid fa-rss" aria-hidden="true"></i></span>
      <div><h2 id="feeds-title">backinjob RSS feeds</h2><p>These category feeds may include jobs other than internships.</p></div>
    </div>
    <article class="chart-card note-card wide feed-note reveal" aria-labelledby="rss-what-title">
      <header class="chart-head"><span class="chip-icon"><i class="fa-solid fa-circle-info" aria-hidden="true"></i></span><div><h3 id="rss-what-title">These are RSS feeds, not websites</h3><p>What they are and how to use them</p></div>
</div>
<div class="menu" id="menu" role="menu" aria-label="Actions" hidden></div>
<script type="application/json" id="search-sources">{{ searchSources | dump | safe }}</script>
<script src="{{ '/assets/board-logic.js' | url }}"></script>
