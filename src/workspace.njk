<div class="workspace">
<h1 class="visually-hidden">Search</h1>

<div class="notice" id="published-notice" hidden>
  <p>
    <strong>You're in preview mode.</strong> You can explore everything. Searching
    and saving need your own copy.
  </p>
  <p>
    To track your applications, run <code>npm run editor</code> on your computer.
  </p>
</div>

<!-- ------------------------------------------------------------------- Hero -->
<div class="gb gb-hero">
  <div class="gb-hero-bg" aria-hidden="true"><span class="gb-blob b1"></span><span class="gb-blob b2"></span><span class="gb-blob b3"></span>
    <span class="gb-orb o1"><i class="fa-solid fa-graduation-cap"></i></span><span class="gb-orb o2"><i class="fa-solid fa-scale-balanced"></i></span>
    <span class="gb-orb o3"><i class="fa-solid fa-laptop-code"></i></span><span class="gb-orb o4"><i class="fa-solid fa-language"></i></span>
  </div>
  <div class="gb-hero-inner">
    <p class="gb-eyebrow"><i class="fa-solid fa-wand-magic-sparkles" aria-hidden="true"></i> Your German Year · private, on this computer only</p>
    <h2 id="tracker-ui-h">Your <span class="gb-grad-text">internship</span> board</h2>
    <p class="gb-lead">Every internship your searches found, checked against the German Year rules. It is your <code>job_search_tracker.xlsx</code>, so edits here are edits there.</p>
    <div class="gb-hero-cta">
      <a class="gb-btn gb-btn-light" href="#board-results"><i class="fa-solid fa-arrow-down" aria-hidden="true"></i> Browse internships</a>
      <button type="button" class="gb-btn gb-btn-glass" data-board-help><i class="fa-solid fa-scale-balanced" aria-hidden="true"></i> How the check works</button>
      <button type="button" class="gb-btn gb-btn-glass" id="btn-check-mail" disabled title="Reads your Gmail (read-only) and proposes status changes for you to approve"><i class="fa-solid fa-envelope-open-text" aria-hidden="true"></i> Check my email</button>
    </div>
    <p class="gb-hero-note" id="mail-status" role="status" aria-live="polite"></p>
    <ul class="gb-stats" aria-label="Your board at a glance">
      <li class="gb-stat-tile"><i class="fa-solid fa-briefcase" aria-hidden="true"></i><strong data-stat="total">0</strong><span>internships</span></li>
      <li class="gb-stat-tile"><i class="fa-solid fa-circle-check" aria-hidden="true"></i><strong data-stat="meets">0</strong><span>meet the rules</span></li>
      <li class="gb-stat-tile"><i class="fa-solid fa-bolt" aria-hidden="true"></i><strong data-stat="fresh">0</strong><span>posted this week</span></li>
      <li class="gb-stat-tile"><i class="fa-solid fa-building" aria-hidden="true"></i><strong data-stat="companies">0</strong><span>companies</span></li>
    </ul>
  </div>
</div>

<nav class="ws-tabs" id="journey-steps" aria-label="Sections of the Search page">
  <a href="#flow-review" data-stage="toapply" data-state="todo"><i class="fa-solid fa-table-list" aria-hidden="true"></i><span><strong>Shortlist</strong><small>Search and your board</small></span></a>
  <a href="#flow-apply" data-stage="applied" data-state="todo"><i class="fa-solid fa-paper-plane" aria-hidden="true"></i><span><strong>Apply</strong><small>You or your assistant</small></span></a>
  <a href="#flow-insights"><i class="fa-solid fa-chart-column" aria-hidden="true"></i><span><strong>Insights</strong><small>Charts from your tracker</small></span></a>
</nav>
<p class="journey-next" id="journey-next" role="status" aria-live="polite"><strong>Start with a search.</strong> <span>One search finds new internships for your major all over Germany, or in every field, and checks each against the GJU rules for you.</span></p>

<!-- ----------------------------------------------------------- Review workspace -->
<section class="workspace-flow review-flow workspace-panel" id="flow-review" aria-labelledby="tracker-ui-h">

  <div class="sx-card shortlist-search">
    <div class="sx-focus">
      <fieldset class="sx-mode">
        <legend>What to search for</legend>
        <label><input type="radio" name="search-mode" value="profile" checked> <span>My major <small id="search-field">Reading your profile…</small></span></label>
        <label><input type="radio" name="search-mode" value="global"> <span>Everything in Germany <small>Internships in every field, not only my major</small></span></label>
      </fieldset>
      {#- The sites a source covers, each with its bundled logo (assets/service-logos); the data is src/_data/searchSources.json. -#}
      {#- One small tile per site: click to toggle individual job boards on or off (Shift/Alt+click to solo one board for fast debugging). -#}
      {% macro siteLogos(list, group) %}<div class="sx-sites-wrap"><div class="sx-sites-bar"><small class="sx-sites-count" data-board-count="{{ group }}">{{ list | length }}/{{ list | length }} boards</small><span class="sx-sites-actions"><button type="button" class="sx-site-btn" data-board-action="all" data-group="{{ group }}" title="Select all boards in this group">All</button><button type="button" class="sx-site-btn" data-board-action="none" data-group="{{ group }}" title="Deselect all boards in this group">None</button></span></div><div class="sx-sites" role="group" aria-label="Job boards for {{ group }}">{% for s in list %}<button type="button" class="sx-site" data-group="{{ group }}" data-board="{{ s.name }}" aria-pressed="true" title="{{ s.name }} — click to toggle, Shift/Alt+click to solo">{% if s.logo %}<img src="{{ ('/assets/service-logos/' + s.logo + '.png') | url }}" alt="{{ s.name }}" width="18" height="18" loading="lazy" onerror="this.replaceWith(this.alt.charAt(0).toUpperCase())">{% else %}{{ s.name | first | upper }}{% endif %}</button>{% endfor %}</div></div>{% endmacro %}
      <fieldset class="sx-sources">
        <legend>Search with <small class="sx-legend-hint">(click any board icon to toggle, or Shift/Alt+click to solo one board)</small></legend>
        <div class="sx-source"><label><input type="checkbox" name="search-source" value="claude" checked> <img class="sx-logo" src="{{ '/assets/service-logos/anthropic.png' | url }}" alt="" width="20" height="20" onerror="this.remove()"> <span>Claude <small data-source-hint="claude">Indeed, StepStone and Arbeitsagentur through your Claude connectors</small></span></label>{{ siteLogos(searchSources.claude, 'claude') }}</div>
        <div class="sx-source"><label><input type="checkbox" name="search-source" value="nim" checked> <img class="sx-logo" src="{{ '/assets/service-logos/nvidia.png' | url }}" alt="" width="20" height="20" onerror="this.remove()"> <span>NVIDIA NIM <small data-source-hint="nim">LinkedIn and other boards through search APIs, no Claude tokens</small></span></label>{{ siteLogos(searchSources.nim, 'nim') }}</div>
        <div class="sx-source"><label><input type="checkbox" name="search-source" value="apis" checked> <i class="fa-solid fa-rss sx-logo" aria-hidden="true"></i> <span>Free job sources <small data-source-hint="apis">Free job APIs and feeds through the JobSearchEngine</small></span></label>{{ siteLogos(searchSources.apis, 'apis') }}</div>
        <div class="sx-source"><label><input type="checkbox" name="search-source" value="companies" checked> <i class="fa-solid fa-building sx-logo" aria-hidden="true"></i> <span>Company websites <small data-source-hint="companies">The job boards of the companies in your directory, asked directly</small></span></label><p class="sx-sites-link"><a href="{{ '/boards/' | url }}#companies">Open the company directory <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a></p></div>
      </fieldset>
      <p class="sx-plan" id="search-plan" role="status" aria-live="polite">Reading your profile…</p>
    </div>
    <footer class="sx-foot">
      <label class="search-profile"><input type="checkbox" id="search-use-profile" disabled> Score new jobs against my profile files <small id="search-ai-hint">Needs an AI provider in .env and your uploaded student files.</small></label>
      <div class="sx-actions">
        <button class="btn btn--primary" id="btn-start-search" type="button"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i> Search new postings</button>
      </div>
    </footer>
    <div class="sx-run">
      <p id="search-run-status" role="status" aria-live="polite">Choose what to search for and which sources to use. A search looks for internships in Germany in German and English: for your major, taken from your profile, or in every field. Free job sources, an NVIDIA NIM model (LinkedIn and other boards through search APIs, no Claude tokens) and your Claude account's connectors (Indeed, StepStone, Arbeitsagentur) each use your own keys, so you decide which to run. Each internship shows which of them found it, and you can filter by it. It adds only internships posted in the last 7 days that the GJU rules do not rule out: 20 weeks to 6 months, in Germany. Pay and language level do not count against a posting, and a low Fit % does not remove one: the Fit % only sorts them. Your notes and decisions stay with each job.</p>
    </div>
  </div>

  <div class="tracker-guidance"><i class="fa-regular fa-lightbulb" aria-hidden="true"></i><p>Open a job's <i class="fa-solid fa-circle-info" aria-hidden="true"></i> <strong>information</strong> to see every field. There, set <strong>Apply? = Yes</strong> for jobs you want, and under <strong>Who applies</strong> choose <strong>Me</strong> or <strong>Assistant</strong>.</p></div>

  {% include "board.njk" %}

  <div class="shadcn-table-wrap" id="tracker-table-wrap" hidden>
    <div class="shadcn-table-scroll" tabindex="0" role="region" aria-label="Editable workbook. Scroll horizontally to see more columns.">
      <table class="shadcn-table" id="tracker-table">
        <caption class="visually-hidden">Job search workbook. Edit individual cells or open row details to edit all fields and notes.</caption>
        <thead><tr id="tracker-thead-tr"></tr></thead>
        <tbody id="tracker-tbody"></tbody>
      </table>
    </div>
    <div class="shadcn-table-footer tracker-pagination">
      <button class="btn" id="tracker-prev" type="button"><i class="fa-solid fa-arrow-left" aria-hidden="true"></i> Previous</button>
      <span id="tracker-page">Page 1</span>
      <button class="btn" id="tracker-next" type="button">Next <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></button>
    </div>
  </div>

  <div class="actions tracker-actions">
    <div class="tracker-action-buttons">
      <button class="btn btn--primary" id="btn-save-tracker" type="button"><i class="fa-solid fa-floppy-disk" aria-hidden="true"></i> Save changes</button>
      <button class="btn" id="btn-add-row" type="button"><i class="fa-solid fa-plus" aria-hidden="true"></i> Add row</button>
      <button class="btn" id="btn-reload-tracker" type="button"><i class="fa-solid fa-rotate" aria-hidden="true"></i> Reload workbook</button>
      <button class="btn" id="btn-clear-tracker" type="button"><i class="fa-solid fa-trash" aria-hidden="true"></i> Delete all applications</button>
      <a class="btn" id="btn-download-tracker" href="/__editor/excel" download="job_search_tracker.xlsx"><i class="fa-solid fa-download" aria-hidden="true"></i> Download workbook</a>
    </div>
    <p id="tracker-status" role="status" aria-live="polite">Loading your workbook...</p>
  </div>
</section>

<!-- ----------------------------------------------------------- Application workspace -->
<section class="workspace-flow apply-flow workspace-panel" id="flow-apply" aria-labelledby="apply-ui-h">
  <div class="flow-heading">
    <div class="flow-heading-copy">
      <span class="flow-step">02 / Apply</span>
      <h2 id="apply-ui-h">Take the next step</h2>
      <p class="lede">Review the jobs assigned to you and to your assistant. You confirm before the assistant starts submitting.</p>
    </div>
    <a class="flow-next-link" href="#flow-review">Edit assignments <i class="fa-solid fa-arrow-up" aria-hidden="true"></i></a>
  </div>

  <div class="apply-overview">
    <div class="apply-ready">
      <h3>Assistant's queue</h3>
      <p id="apply-summary" role="status" aria-live="polite">Loading selected applications...</p>
      <p class="apply-criteria">Jobs assigned to <strong>Assistant</strong>, with <strong>Apply? = Yes</strong> and <strong>To apply</strong>, appear here.</p>
      <button class="btn" id="btn-assign-applicant" type="button"><i class="fa-solid fa-user-check" aria-hidden="true"></i> Let the assistant take what it can</button>
      <p class="apply-criteria">Reads the jobs shown in the tracker that are yours (<strong>Me</strong>, <strong>Apply? = Yes</strong>, <strong>To apply</strong>) and changes <strong>Applicant</strong> to Assistant where it can apply. Nothing is sent.</p>
      <button class="btn btn--primary" id="btn-apply-selected" type="button"><i class="fa-solid fa-paper-plane" aria-hidden="true"></i> Review & apply</button>
      <p id="apply-status" role="status" aria-live="polite">Your first application is previewed before submission.</p>
    </div>
    <aside class="apply-connection" aria-labelledby="apply-contact-h">
      <h3 id="apply-contact-h">Your contact & application method</h3>
      <p id="apply-contact">Loading the contact details saved in your profile...</p>
      <p id="apply-tools" role="status">Checking your application connection...</p>
      <p>Web forms use your saved contact details and application documents. Email applications need a connected email account and sending tool; until then, they are marked <strong>Needs input</strong>.</p>
      <a href="{{ '/editor/' | url }}" class="flow-next-link">Edit profile in Profile Editor <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
      <a href="{{ '/documents/' | url }}" class="flow-next-link" style="display:block; margin-top:0.4rem;">Open CVs &amp; CLs Studio <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
    </aside>
  </div>
  <div id="apply-queue" class="apply-queue" aria-label="Selected applications"></div>
</section>

<section class="workspace-utility workspace-panel" id="flow-insights" aria-labelledby="analytics-h">
<details class="workspace-tools" id="insights" open>
  <summary><span>Application insights</span><small>What your tracker says about where to go next</small></summary>
  <div class="utility-content">
  <h2 id="analytics-h">Your insights</h2>
  <p class="lede">Drawn from your own tracker, your profile skills and the GJU rules. Nothing leaves your computer.</p>
  <p id="insights-empty" class="notice-empty">Your first application unlocks these charts. Add one in the workbook above, and this page starts showing you where to focus.</p>
  <div class="grid-2 chart-grid" id="insights-grid" hidden>
    <div class="card chart-card chart-card--wide" id="card-gates" hidden>
      <h3>Each posting against the GJU minimums</h3>
      <p class="muted">Percent above (green) or below (red) the line: 20 weeks, and the monthly pay needed for a visa extension.</p>
      <div id="chart-gates" class="chart-container"></div>
    </div>
    <div class="card chart-card" id="card-quadrant" hidden>
      <h3>Where to spend your effort</h3>
      <p class="muted">Match score across, pay up. Top right is the place to apply first.</p>
      <div id="chart-quadrant" class="chart-container"></div>
    </div>
    <div class="card chart-card" id="card-skills" hidden>
      <h3>Skills postings ask for</h3>
      <p class="muted"><span class="key key--have"></span> You have it &nbsp; <span class="key key--gap"></span> A gap to close with <code>/upskill</code></p>
      <div id="chart-skills" class="chart-container"></div>
    </div>
    <div class="card chart-card" id="card-dates" hidden>
      <h3>Coming up</h3>
      <p class="muted"><span class="key" style="background:#F87171"></span> Deadline &nbsp; <span class="key" style="background:#38BDF8"></span> Follow-up &nbsp; <span class="key" style="background:#34D399"></span> Interview. The next two weeks; overdue ones sit at day 0.</p>
      <div id="chart-dates" class="chart-container"></div>
    </div>
    <div class="card chart-card" id="card-sources" hidden>
      <h3>Which sources get replies</h3>
      <p class="muted">Where each source's postings ended up. <span id="legend-sources"></span></p>
      <div id="chart-sources" class="chart-container"></div>
    </div>
    <div class="card chart-card" id="card-tally" hidden>
      <h3>Effort, counted</h3>
      <p class="muted">One mark for each thing you did. Every one counts.</p>
      <div id="chart-tally" class="chart-container"></div>
    </div>
    <div class="card chart-card chart-card--wide" id="card-calendar" hidden>
      <h3>The days you sent applications</h3>
      <div id="chart-calendar" class="chart-container chart-container--short"></div>
    </div>
  </div>
  </div>
</details>
</section>
</div>

{# The checker and the table are driven by the same rules the workbook uses.
   Passing them as JSON keeps the numbers in one place. #}
<script src="{{ '/assets/thinking-orbs.js' | url }}"></script>
<script src="{{ '/assets/ai-status.js' | url }}"></script>
<script src="/assets/opencharts/lib/chart.umd.min.js"></script>
<script src="/assets/opencharts/lib/d3.min.js"></script>
<script type="application/json" id="profile-skills">{{ profile.skills | dump | safe }}</script>

<script type="application/json" id="gju-rules">{{ gju | dump | safe }}</script>
<script type="application/json" id="tracker-schema">{{ tracker | dump | safe }}</script>









