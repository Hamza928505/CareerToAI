<!-- ------------------------------------------------------------ Run a task or command -->
<section class="workspace-utility workspace-panel" id="flow-tools" aria-labelledby="tasks-h">
<details class="workspace-tools">
  <summary><span>Tools & commands</span><small>Profile, workbook, and assistant utilities</small></summary>
  <div class="utility-content">
  <h2 id="tasks-h">Workspace tools</h2>
  <p class="lede">
    These are the AI commands to run in your assistant, and the deterministic steps that read <code>data/</code> and write generated files. You can copy the commands or try running them directly.
  </p>

  <div class="grid task-grid task-grid">
    <!-- Tasks -->
    <article class="card task" data-task="profile">
      <span class="eyebrow">npm run profile</span>
      <h3>Rebuild candidate profile</h3>
      <p>Regenerates <code>01-candidate-profile.md</code> from your profile JSON.</p>
      <div class="task-actions">
        <button class="btn btn--primary" type="button" data-run="profile"><i class="fa-solid fa-play btn-icon-spacing"></i>Run</button>
        <button class="btn" type="button" data-copy="npm run profile"><i class="fa-regular fa-copy btn-icon-spacing"></i>Copy</button>
      </div>
    </article>

    <article class="card task" data-task="tracker">
      <span class="eyebrow">npm run tracker</span>
      <h3>Rebuild workbook</h3>
      <p>Renders <code>job_search_tracker.xlsx</code> from your tracker rows.</p>
      <div class="task-actions">
        <button class="btn btn--primary" type="button" data-run="tracker"><i class="fa-solid fa-play btn-icon-spacing"></i>Run</button>
        <button class="btn" type="button" data-copy="npm run tracker"><i class="fa-regular fa-copy btn-icon-spacing"></i>Copy</button>
      </div>
    </article>

    <article class="card task" data-task="skills">
      <span class="eyebrow">npm run skills:harvest</span>
      <h3>Harvest advert skills</h3>
      <p>Pulls the requirements out of every tracked posting into your skill pool.</p>
      <div class="task-actions">
        <button class="btn btn--primary" type="button" data-run="skills"><i class="fa-solid fa-play btn-icon-spacing"></i>Run</button>
        <button class="btn" type="button" data-copy="npm run skills:harvest"><i class="fa-regular fa-copy btn-icon-spacing"></i>Copy</button>
      </div>
    </article>

    <article class="card task" data-task="build">
      <span class="eyebrow">npm run build</span>
      <h3>Rebuild site</h3>
