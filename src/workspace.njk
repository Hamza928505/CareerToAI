---
layout: base.njk
title: Workspace - search, review, apply
description: Search for jobs, edit your workbook, and decide who applies from one workspace.
permalink: /workspace/
noindex: true
pageStyles: /assets/workspace.css
pageScript: /assets/workspace.js
eleventyExcludeFromCollections: true
---

<div class="workspace">
<div class="ws-head hero">
  <div>
    <span class="eyebrow">Your German Year</span>
    <h1>Your German Year <span class="hero-accent">starts here.</span></h1>
    <p class="lede">Every application you send is one step closer. Pick where to begin, and we'll show you what to do next.</p>
  </div>
  <p class="mode" id="mode" data-state="checking">
    <span class="pill pill--idle" id="mode-pill">Checking connection...</span>
  </p>
</div>

<div class="notice" id="published-notice" hidden>
  <p>
    <strong>You're in preview mode.</strong> You can explore everything, and the
    eligibility checker works right now. Saving needs your own copy.
  </p>
  <p>
    To track your applications, run <code>npm run editor</code> on your computer.
  </p>
</div>

<!-- ---------------------------------------------------------------- Overview -->
<section class="workspace-overview" aria-labelledby="overview-h">
  <h2 id="overview-h" class="visually-hidden">Your application progress</h2>

  <div class="stat-row" id="stats">
    <div class="stat">
      <span class="stat-label">Tracked</span>
      <span class="stat-value" id="stat-total">—</span>
      <span class="stat-note">applications in <code>job_search_tracker.xlsx</code></span>
    </div>
    <div class="stat">
      <span class="stat-label">Still open</span>
      <span class="stat-value" id="stat-open">—</span>
      <span class="stat-note">not yet accepted, rejected or withdrawn</span>
    </div>
    <div class="stat">
      <span class="stat-label">To apply</span>
      <span class="stat-value" id="stat-toapply">—</span>
      <span class="stat-note">decided, not sent</span>
    </div>
    <div class="stat">
      <span class="stat-label">Interviews</span>
      <span class="stat-value" id="stat-interview">—</span>
      <span class="stat-note">invited or already sat</span>
    </div>
  </div>
  <div class="chart-card overview-chart" hidden>
    <h3>How far your applications got</h3>
    <p id="summary-chart-note" class="muted">Each stage counts everything that got that far, so the numbers only ever shrink. Every offer starts as a tracked posting.</p>
    <p id="funnel-empty" class="notice-empty" hidden>Nothing sent yet, and that is fine. Your first application starts this chart, and every stage after it fills in as you go.</p>
    <div id="chart-funnel" class="chart-container" aria-describedby="summary-chart-note"></div>
  </div>
</section>

<form class="svc-card" id="settings-form" autocomplete="off" aria-labelledby="credits-h">
  <header class="svc-head">
    <div class="svc-title">
      <h2 id="credits-h">Search &amp; AI services</h2>
      <p class="muted" id="credits-note">Checked live from your own keys in <code>.env</code>. Only numbers show here, never the keys.</p>
    </div>
    <div class="svc-tabs" role="tablist" aria-label="Search services sections">
      <button type="button" role="tab" id="svc-tab-overview" aria-controls="svc-panel-overview" aria-selected="true" data-tab="overview">Overview</button>
      <button type="button" role="tab" id="svc-tab-keys" aria-controls="svc-panel-keys" aria-selected="false" tabindex="-1" data-tab="keys" data-local-only hidden>Keys</button>
      <button type="button" role="tab" id="svc-tab-ai" aria-controls="svc-panel-ai" aria-selected="false" tabindex="-1" data-tab="ai" data-local-only hidden>AI provider</button>
    </div>
  </header>

  <div class="svc-body" id="credits">
    <div role="tabpanel" id="svc-panel-overview" aria-labelledby="svc-tab-overview" tabindex="0">
      <div class="svc-status" id="svc-status" hidden>
        <span class="svc-avatar" aria-hidden="true"><i class="fa-solid fa-signal"></i></span>
        <div class="svc-status-text"><strong id="svc-status-title"></strong><small id="svc-status-desc"></small></div>
        <span class="svc-badge" id="svc-status-badge"></span>
      </div>
      <div class="svc-meter" id="svc-meter" hidden>
        <div class="svc-meter-label"><span>Keys saved</span><span id="svc-meter-value"></span></div>
        <div class="credit-bar" role="meter" aria-valuemin="0" aria-valuemax="100" aria-label="Keys saved"><div class="credit-fill" id="svc-meter-fill" data-level="ok"></div></div>
      </div>
      <ul class="credit-list" id="credit-list"></ul>
      <div class="svc-stats" id="svc-stats" hidden>
        <div class="svc-stat"><span>Services answering</span><strong id="svc-stat-ok">-</strong></div>
        <div class="svc-stat"><span>AI provider</span><strong id="svc-stat-ai">Not set</strong></div>
      </div>
    </div>

    <div role="tabpanel" id="svc-panel-keys" aria-labelledby="svc-tab-keys" tabindex="0" hidden>
      <p class="muted">Keys are saved to <code>.env</code> on this computer. They are never shown again, and never sent to your browser or to GitHub. Type a new key to replace one, or remove it.</p>
      <h3 class="svc-sub">Search services</h3>
      <div id="settings-search" class="settings-rows"></div>
      <h3 class="svc-sub">Other API keys</h3>
      <div id="settings-custom" class="settings-rows"></div>
      <div class="settings-add">
        <input id="custom-name" type="text" autocomplete="off" spellcheck="false" placeholder="Name, e.g. SERPER_API_KEY" aria-label="Name of the new key">
        <input id="custom-value" type="password" autocomplete="off" spellcheck="false" placeholder="Paste the key" aria-label="Value of the new key">
        <button type="button" class="btn" id="custom-add"><i class="fa-solid fa-plus" aria-hidden="true"></i> Add key</button>
      </div>
      <small class="settings-help">A name must end in <code>_API_KEY</code>, <code>_KEY</code>, <code>_TOKEN</code> or <code>_SECRET</code>. Tools and MCP servers that read <code>${NAME}</code> pick it up.</small>
    </div>

    <div role="tabpanel" id="svc-panel-ai" aria-labelledby="svc-tab-ai" tabindex="0" hidden>
      <p class="muted">Used for suggestions, job scoring and CV/letter tailoring. Pick one provider and add its key.</p>
      <div id="settings-ai" class="settings-rows"></div>
    </div>
  </div>

  <footer class="svc-foot">
    <p id="settings-status" role="status" aria-live="polite"></p>
    <div class="svc-foot-actions">
      <button class="btn" type="button" id="credits-refresh" data-for="overview"><i class="fa-solid fa-rotate" aria-hidden="true"></i> Refresh</button>
      <button class="btn" type="button" id="settings-test" data-for="ai" hidden><i class="fa-solid fa-plug" aria-hidden="true"></i> Test AI provider</button>
      <button class="btn btn--primary" type="submit" id="settings-save" data-for="keys ai" hidden><i class="fa-solid fa-floppy-disk" aria-hidden="true"></i> Save changes</button>
    </div>
  </footer>
</form>

<section class="journey" aria-labelledby="journey-h">
  <h2 id="journey-h" class="visually-hidden">Your journey and workspace sections</h2>
  <ol class="journey-steps" id="journey-steps">
    <li data-stage="check" data-state="todo"><a href="#flow-check"><span class="journey-dot">1</span><strong>Check</strong><small>GJU rules</small></a></li>
    <li data-stage="search" data-state="todo"><a href="#flow-search"><span class="journey-dot">2</span><strong>Search</strong><small>Roles and locations</small></a></li>
    <li data-stage="toapply" data-state="todo"><a href="#flow-review"><span class="journey-dot">3</span><strong>Shortlist</strong><small>Your workbook</small></a></li>
    <li data-stage="applied" data-state="todo"><a href="#flow-apply"><span class="journey-dot">4</span><strong>Apply</strong><small>You or your assistant</small></a></li>
    <li data-stage="insights" data-state="todo"><a href="#flow-insights"><span class="journey-dot">5</span><strong>Insights</strong><small>Charts</small></a></li>
    <li data-stage="tools" data-state="todo"><a href="#flow-tools"><span class="journey-dot">6</span><strong>Tools</strong><small>Commands</small></a></li>
  </ol>
  <p class="journey-next" id="journey-next" role="status" aria-live="polite"><strong>Start with one posting.</strong> <span>Check it against the GJU rules below, then add it to your list. One is enough to begin.</span></p>
</section>

<!-- ------------------------------------------------------ Eligibility check -->
<section class="workspace-utility workspace-check workspace-panel" id="flow-check" aria-labelledby="check-h">
<details class="workspace-tools" open>
  <summary><span>GJU eligibility checker</span><small>Check duration, location, pay, and language</small></summary>
  <div class="utility-content">
  <h2 id="check-h">Check a posting against the GJU rules</h2>
  <p class="lede">
    The same thresholds the tracker scores with, read from
    <code>data/gju-rules.json</code>. This runs in your browser and sends nothing
    anywhere.
  </p>

  <form class="card checker" id="checker" novalidate>
    <div class="field-row">
      <p class="field">
        <label><input type="checkbox" id="f-werkstudent" name="werkstudent"> Werkstudent (part-time, about {{ gju.rules.werkstudentHoursPerMonth }} hours a month)</label>
        <span class="help">Ticking this ignores the duration rule: a Werkstudent role is not measured in weeks.</span>
      </p>
      <p class="field">
        <label for="f-weeks">Duration in weeks <span aria-hidden="true">*</span></label>
        <input type="number" id="f-weeks" name="weeks" value="{{ gju.rules.minWeeks }}" min="{{ gju.rules.minWeeks }}" max="52" inputmode="numeric" required>
        <span class="help">GJU requires at least {{ gju.rules.minWeeks }} weeks.</span>
      </p>

      <p class="field">
        <label for="f-country">Country <span aria-hidden="true">*</span></label>
        <select id="f-country" name="country" required>
          {% for c in gju.countries %}<option value="{{ c[0] }}"{% if c[0] == "Germany" %} selected{% endif %}>{{ c[0] }}</option>{% endfor %}
        </select>
        <span class="help">Anywhere outside the German-speaking countries needs approval.</span>
      </p>
    </div>

    <div class="field-row">
      <p class="field">
        <label for="f-paid">Paid?</label>
        <select id="f-paid" name="paid">
          <option value="">Not stated</option>
          <option value="Yes">Yes</option>
          <option value="No">No — unpaid</option>
        </select>
      </p>

      <p class="field">
        <label for="f-pay">Pay, EUR per month</label>
        <input type="number" id="f-pay" name="pay" min="0" step="10" inputmode="numeric">
        <span class="help">Unpaid is allowed. The {{ gju.rules.minMonthlySalary }} EUR/month only matters if you stay beyond the year (visa extension) and your blocked account is not refilled. Leave this blank if you don't know.</span>
      </p>

      <p class="field">
        <label for="f-language">Working language</label>
        <select id="f-language" name="language">
          <option value="">Not stated</option>
          <option value="English">English</option>
          <option value="Both" selected>Both</option>
          <option value="German">German only</option>
        </select>
      </p>
    </div>

    <p class="field">
      <label for="f-german">Your German level</label>
      <select id="f-german" name="german">
        <option value="A1">A1</option><option value="A2">A2</option>
        <option value="B1">B1</option><option value="B2" selected>B2</option>
        <option value="C1">C1</option><option value="C2">C2</option>
      </select>
      <span class="help">German-only postings score full marks from B2 upward.</span>
    </p>

    <div class="checker-actions">
      <button class="btn btn--primary" type="submit"><i class="fa-solid fa-check-double btn-icon-spacing"></i>Check it</button>
      <button class="btn" type="reset"><i class="fa-solid fa-eraser btn-icon-spacing"></i>Clear</button>
    </div>
  </form>

  <div id="verdict" class="verdict" hidden aria-live="polite"></div>
  </div>
</details>
</section>

<!-- -------------------------------------------------------- Search Strategy -->
<section class="strategy workspace-flow workspace-panel" id="flow-search" aria-labelledby="strategy-ui-h">
  <div class="flow-heading strategy-heading">
    <div class="flow-heading-copy">
      <span class="flow-step">01 / Search</span>
      <h2 id="strategy-ui-h">Job search strategy</h2>
      <p class="lede">Pick the work you want and where you want to do it. Start your search right here.</p>
    </div>
    <a class="flow-next-link" href="#flow-review">Go to your workbook <i class="fa-solid fa-arrow-down" aria-hidden="true"></i></a>
  </div>

  {% set strategyGroups = [
    { key: 'roles', tab: 'Roles', title: 'Roles to look for', help: 'Choose the fields that match your work and interests.', options: ['Software Engineering', 'Backend', 'Full-Stack .NET', 'Computer Vision', 'Machine Learning', 'Frontend', 'Data Engineering', 'Cloud / DevOps'] },
    { key: 'cities', tab: 'Places', title: 'Where to search', help: 'Select cities or a wider search area.', options: ['Berlin', 'Remote', 'Germany-wide', 'München', 'Hamburg', 'Frankfurt am Main', 'Köln', 'Stuttgart', 'Düsseldorf', 'Leipzig'] },
    { key: 'types', tab: 'Types', title: 'Opportunity type', help: 'Choose the kinds of positions you want.', options: tracker.opportunityTypes }
  ] %}
  <form id="strategy-form" class="strategy-form sx-card">
    <header class="sx-head">
      <div class="sx-tabs" role="tablist" aria-label="What to search for">
        {% for group in strategyGroups %}
        <button type="button" role="tab" id="sx-tab-{{ group.key }}" class="sx-tab" data-sx-tab="{{ group.key }}" data-group="{{ group.key }}" aria-controls="sx-panel-{{ group.key }}" aria-selected="{{ 'true' if loop.first else 'false' }}"{% if not loop.first %} tabindex="-1"{% endif %}>{{ group.tab }}<span class="sx-count" data-sx-count="{{ group.key }}">0</span></button>
        {% endfor %}
      </div>
      <div class="sx-total">
        <strong id="strategy-count">0 search preferences selected</strong>
        <p id="strategy-save-status" role="status" aria-live="polite">Your preferences are saved when you start a search.</p>
      </div>
    </header>

    <div class="sx-body">
      {% for group in strategyGroups %}
      <div class="strategy-group sx-panel" id="sx-panel-{{ group.key }}" data-group="{{ group.key }}" role="tabpanel" aria-labelledby="strategy-{{ group.key }}-h" aria-describedby="strategy-{{ group.key }}-help"{% if not loop.first %} hidden{% endif %}>
        <div class="strategy-group-copy">
          <h3 id="strategy-{{ group.key }}-h">{{ group.title }}</h3>
          <p id="strategy-{{ group.key }}-help">{{ group.help }}</p>
        </div>
        <div class="strategy-group-controls">
          <div class="strategy-options" data-strategy-options="{{ group.key }}">
            {% for option in group.options %}
            <label class="strategy-choice"><input type="checkbox" name="{{ group.key }}" value="{{ option }}"><span>{{ option }}<i class="fa-solid fa-check" aria-hidden="true"></i></span></label>
            {% endfor %}
          </div>
          <div class="strategy-add">
            <label for="strat-custom-{{ group.key }}">{% if group.key == 'roles' %}Search all roles or add your own{% elif group.key == 'cities' %}Search all German cities or add a location{% else %}Add another opportunity type{% endif %}</label>
            <div class="strategy-add-controls">
              <input id="strat-custom-{{ group.key }}" type="search" maxlength="80" autocomplete="off" placeholder="{% if group.key == 'roles' %}Search a job title{% elif group.key == 'cities' %}Search a city{% else %}Type an opportunity type{% endif %}" data-strategy-custom="{{ group.key }}"{% if group.key != 'types' %} data-strategy-search="{{ group.key }}" aria-controls="strat-results-{{ group.key }}"{% endif %}>
              <button class="btn" type="button" data-strategy-add="{{ group.key }}">{{ 'Add custom' if group.key != 'types' else 'Add' }}</button>
              {% if group.key == 'roles' %}<button type="button" class="btn strategy-suggest" id="btn-suggest-strategy" disabled><i class="fa-solid fa-wand-magic-sparkles" aria-hidden="true"></i> Suggest from my files</button>{% endif %}
            </div>
            {% if group.key == 'roles' %}<button class="strategy-browse" type="button" data-strategy-browse="roles" aria-controls="strat-results-roles" aria-expanded="false">Browse all roles <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></button>{% endif %}
            {% if group.key != 'types' %}<div class="strategy-results" id="strat-results-{{ group.key }}" data-strategy-results="{{ group.key }}" hidden></div>{% endif %}
          </div>
        </div>
      </div>
      {% endfor %}
    </div>

    <div class="sx-summary">
      <span class="sx-summary-label">Your search</span>
      <ul class="sx-chips" id="sx-chips" aria-label="Everything you chose so far"><li class="sx-empty">Nothing chosen yet.</li></ul>
    </div>

    <footer class="sx-foot">
      <label class="search-profile"><input type="checkbox" id="search-use-profile" disabled> Score new jobs against my profile files <small id="search-ai-hint">Needs an AI provider in .env and your uploaded student files.</small></label>
      <div class="sx-actions">
        <button type="submit" class="btn" id="btn-save-strategy">Save strategy</button>
        <button class="btn btn--primary" id="btn-start-search" type="button"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i> Search today's postings</button>
      </div>
    </footer>

    <div class="sx-run">
      <p id="search-run-status" role="status" aria-live="polite">Searches the 20 listed platforms. Only live individual postings with a verified publication date of today are added. Your notes and decisions stay with each job.</p>
      <details class="search-sources"><summary>Show platforms included</summary><ul>
        <li>Indeed · Jobmensa · Monster · StepStone · Arbeitsagentur Jobbörse · Stellenanzeigen · academics · Kimeta · Jobworld · meinestadt.de</li>
        <li>meinpraktikum.de · Praktikumsstellen · praktika.de · praktikum.info · praktikum.de · connecticum · Jobware · UNICUM · bonding · Absolventa</li>
      </ul></details>
    </div>
  </form>
</section>

<!-- ----------------------------------------------------------- Review workspace -->
<section class="workspace-flow review-flow workspace-panel" id="flow-review" aria-labelledby="tracker-ui-h">
  <div class="flow-heading">
    <div class="flow-heading-copy">
      <span class="flow-step">02 / Review & edit</span>
      <h2 id="tracker-ui-h">Make your shortlist</h2>
      <p class="lede">Your <code>job_search_tracker.xlsx</code> workbook opens here. Edit cells, add notes, and decide who applies to each job.</p>
    </div>
    <span class="workbook-label"><i class="fa-regular fa-file-excel" aria-hidden="true"></i> Excel workbook</span>
  </div>

  <div class="tracker-guidance"><i class="fa-regular fa-lightbulb" aria-hidden="true"></i><p>Set <strong>Apply? = Yes</strong> for jobs you want. Under <strong>Who applies</strong>, choose <strong>Me</strong> or <strong>Assistant</strong>. Open a row's details for longer notes and every field.</p></div>

  <div class="tracker-toolbar">
    <label class="tracker-filter">Find a job<input id="tracker-filter" type="search" placeholder="Company, role, city, keyword" /></label>
    <label>Opportunity type<select id="tracker-opportunity-filter"><option value="">Any type</option>{% for type in tracker.opportunityTypes %}<option value="{{ type }}">{{ type }}</option>{% endfor %}<option value="_unspecified">Unspecified</option></select></label>
    <label>City<select id="tracker-city-filter"><option value="">Any city</option></select></label>
    <label>Minimum match<select id="tracker-score-filter"><option value="">Any score</option><option value="50">50+</option><option value="60">60+</option><option value="70">70+</option><option value="80">80+</option><option value="90">90+</option><option value="_unknown">Not scored</option></select></label>
    <label>Status<select id="tracker-status-filter"><option value="">Any status</option></select></label>
  </div>
  <details class="tracker-more-filters" id="tracker-more-filters">
    <summary>More filters <span id="tracker-filter-count"></span></summary>
    <div class="tracker-toolbar tracker-toolbar--more">
      <label>Date field<select id="tracker-date-field"><option value="date_posted">Date posted</option><option value="date_found">Date found</option><option value="deadline">Deadline</option><option value="date_applied">Date sent</option><option value="follow_up">Follow-up date</option><option value="last_contact_date">Last contact date</option><option value="start_date">Start date</option><option value="next_action_date">Next action date</option><option value="interview_date">Interview date</option><option value="response_date">Response date</option></select></label>
      <label>From<input id="tracker-date-from" type="date" /></label>
      <label>To<input id="tracker-date-to" type="date" /></label>
      <label>Date available<select id="tracker-date-status-filter"><option value="">Any</option><option value="yes">Known date</option><option value="no">Missing date</option></select></label>
      <label>Decision<select id="tracker-decision-filter"><option value="">Any decision</option><option>Yes</option><option>No</option><option>Maybe</option></select></label>
      <label>Who applies<select id="tracker-applicant-filter"><option value="">Anyone</option><option>Me</option><option>Assistant</option></select></label>
      <label>Work mode<select id="tracker-work-mode-filter"><option value="">Any mode</option><option>On-site</option><option>Hybrid</option><option>Remote</option><option value="_unspecified">Unspecified</option></select></label>
      <label>Source<select id="tracker-source-filter"><option value="">Any source</option><option>LinkedIn</option><option>Company site</option><option>Referral</option><option>Job fair</option><option>Other</option></select></label>
      <label>Posting link<select id="tracker-link-filter"><option value="">Any</option><option value="yes">Available</option><option value="no">Missing</option></select></label>
      <label>Any other column<select id="tracker-field-filter"><option value="">Choose a column</option></select></label>
      <label>Contains<input id="tracker-value-filter" type="search" placeholder="Value in chosen column" /></label>
      <button class="btn tracker-clear-filters" id="tracker-clear-filters" type="button">Clear filters</button>
    </div>
  </details>
  <div class="tracker-view-bar">
    <label for="tracker-column-view">Columns to show <select id="tracker-column-view"><option value="review">Shortlist essentials</option><option value="all">All columns</option><option value="contact">Company & contact</option><option value="requirements">Job requirements</option><option value="application">Application details</option></select></label>
    <span id="tracker-total-count" class="tracker-count">Loading tracker...</span>
    <button class="btn tracker-expand" id="tracker-expand" type="button" aria-pressed="false" title="Open the shortlist as a full-screen window (Esc closes it)"><i class="fa-solid fa-expand" aria-hidden="true"></i> <span>Open as window</span></button>
  </div>

  <div class="shadcn-table-wrap" id="tracker-table-wrap" hidden>
    <div class="shadcn-table-scroll" tabindex="0" role="region" aria-label="Editable workbook. Scroll horizontally to see more columns.">
      <table class="shadcn-table" id="tracker-table">
        <caption class="visually-hidden">Job search workbook. Edit individual cells or open row details to edit all fields and notes.</caption>
        <thead><tr id="tracker-thead-tr"></tr></thead>
        <tbody id="tracker-tbody"></tbody>
      </table>
    </div>
    <div class="shadcn-table-footer tracker-pagination">
      <button class="btn" id="tracker-prev" type="button"><i class="fa-solid fa-arrow-left" aria-hidden="true"></i> Previous</button>
      <span id="tracker-page">Page 1</span>
      <button class="btn" id="tracker-next" type="button">Next <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></button>
    </div>
  </div>

  <div class="actions tracker-actions">
    <div class="tracker-action-buttons">
      <button class="btn btn--primary" id="btn-save-tracker" type="button"><i class="fa-solid fa-floppy-disk" aria-hidden="true"></i> Save changes</button>
      <button class="btn" id="btn-add-row" type="button"><i class="fa-solid fa-plus" aria-hidden="true"></i> Add row</button>
      <button class="btn" id="btn-reload-tracker" type="button"><i class="fa-solid fa-rotate" aria-hidden="true"></i> Reload workbook</button>
      <a class="btn" id="btn-download-tracker" href="/__editor/excel" download="job_search_tracker.xlsx"><i class="fa-solid fa-download" aria-hidden="true"></i> Download Excel</a>
    </div>
    <p id="tracker-status" role="status" aria-live="polite">Loading your workbook...</p>
