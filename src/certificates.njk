---
layout: base.njk
permalink: /certificates/
schemaType: collection
---

<h1>Certificates</h1>
<p class="lede">
  {{ certificates.length }} credential{{ "" if certificates.length == 1 else "s" }} held by
  {{ profile.name }}, newest first. Each links to its own page with the full description,
  every skill it covers, and the certificate image.
</p>

{% if certificates.length %}
<ul class="cert-list">
  {%- for cert in certificates %}
  <li>
    <article class="cert-card">
      {% if cert.certificateImage %}
      <a class="thumb" href="{{ cert.permalink | url }}" tabindex="-1" aria-hidden="true">
        <img src="{{ cert.certificateImage | url }}" alt=""
             {% if cert.certificateImageWidth %}width="{{ cert.certificateImageWidth }}" height="{{ cert.certificateImageHeight }}"{% endif %}
             loading="lazy" decoding="async">
      </a>
      {% endif %}
      <div class="cert-card-body">
        <h2><a href="{{ cert.permalink | url }}">{{ cert.title }}</a></h2>
        <p class="issuer">{{ cert.issuer }}</p>
        <dl class="facts compact">
          {% if cert.issued %}<dt>Issued</dt><dd><time datetime="{{ cert.issued.iso }}">{{ cert.dateIssued | humanDate }}</time></dd>{% endif %}
          {% if cert.expires %}<dt>{{ "Expired" if cert.isExpired else "Expires" }}</dt><dd><time datetime="{{ cert.expires.iso }}">{{ cert.dateExpires | humanDate }}</time></dd>{% endif %}
          {% if cert.credentialId %}<dt>Credential ID</dt><dd>{{ cert.credentialId }}</dd>{% endif %}
        </dl>
        <p>{{ cert.description }}</p>
        {% if cert.skills.length %}
        <h3 class="skills-heading">Skills covered</h3>
        <ul class="skills">
          {%- for skill in cert.skills %}<li>{{ skill }}</li>{%- endfor %}
        </ul>
        {% endif %}
      </div>
    </article>
  </li>
  {%- endfor %}
</ul>
{% else %}
<p class="muted">No certificates published yet. Run <code>npm run add-cert -- &lt;file&gt;</code> to add one.</p>
{% endif %}
