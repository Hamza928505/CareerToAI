# Secrets — never commit
.env
.env.*
!.env.example

# Full-resolution certificate originals stay on your machine only.
# Only the downscaled, EXIF-stripped copies in src/certs/ are published.
certs-source/*
!certs-source/.gitkeep

# Generated by `npm run tracker` from data/ — regenerate, do not commit.
internship-tracker.xlsx

# Skill sources built by npm run skills:import / skills:harvest.
# Local authoring aids: the editor works without them.
data/skill-taxonomy.json
data/skill-pool.json

# Knowledge graph built by /graphify — regenerate, do not commit.
graphify-out/

# Build output & deps
_site/
node_modules/
.cache/
*.log
npm-debug.log*

# OS noise
.DS_Store
Thumbs.db

# --- job-search framework (see job-search/.gitignore for the rest) ---
# job-search/.gitignore covers everything under job-search/. These rules cover
# the skills surfaced at the repo root in .claude/skills/, which resolve their
# data directories relative to themselves and so land outside that file's reach.
**/job_scraper/seen_jobs.json
**/job_scraper/notion_sync.json
**/job_scraper/*.md
**/upskill/report-*.md
salary_data.json
gmail_sync/
reports/
skills-lock.json

# Python noise, in case a framework tool is run from the repo root.
__pycache__/
*.pyc
*.pyo
.venv/
venv/
