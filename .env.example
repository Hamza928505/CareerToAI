# Copy to .env and fill in. .env is git-ignored and is ONLY read by
# scripts/add-cert.mjs, which runs on your machine. It is never bundled
# into the site, never read at build time, and never sent to GitHub.
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the extraction model (default: claude-opus-5)
# ANTHROPIC_MODEL=claude-opus-5

# Search credits (workspace > Tools). Local only; the keys never leave your machine.
FIRECRAWL_API_KEY=fc-...
TAVILY_API_KEY=tvly-...
TINYFISH_API_KEY=sk-tinyfish-...
EXA_API_KEY=...

# Optional: run the in-app AI (profile suggestions, job scoring, CV/letter tailoring)
# on your own provider instead of Anthropic. One of: ollama, openrouter, nvidia, github, anthropic
# LLM_PROVIDER=ollama
# LLM_MODEL=llama3.1
# LLM_BASE_URL=http://localhost:11434/v1
# OPENROUTER_API_KEY=sk-or-...
# NVIDIA_API_KEY=nvapi-...
# GITHUB_MODELS_TOKEN=github_pat_...

# Applications sent by email (CV + cover letter attached). Preferred: the Gmail API with a
# send-only permission. Create an OAuth client of type "Desktop app" in Google Cloud, put its
# id and secret here, then run: npm run gmail:auth   (it fills GMAIL_REFRESH_TOKEN).
# GMAIL_CLIENT_ID=...apps.googleusercontent.com
# GMAIL_CLIENT_SECRET=...
# GMAIL_REFRESH_TOKEN=...
# GMAIL_SENDER=you@gmail.com
# Or plain SMTP instead (Gmail needs an app password):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@example.com
# SMTP_PASS=...
# SMTP_FROM=You <you@example.com>
# Set to 1 to run the application browser without a window (default: a visible window).
# APPLY_HEADLESS=1
# Optional: send replies to a different mailbox than the one that sends. Default: the sending account.
# APPLY_REPLY_TO=you@example.com
