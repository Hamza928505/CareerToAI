{
  "$comment": "Canonical shape of the application tracker.",
  "csv": "data/applications.csv",
  "workbook": "applications.xlsx",
  "sheet": "Search",
  "columns": [
    { "key": "id", "header": "ID", "width": 10, "required": true },
    { "key": "apply", "header": "APPLY?", "width": 10, "enum": "applyDecisions" },
    { "key": "reason", "header": "Reason", "width": 20 },
    { "key": "date_found", "header": "Date found", "width": 12, "format": "date" },
    { "key": "source", "header": "Source site", "width": 15 },
    { "key": "job_url", "header": "Job URL", "width": 25 },
    { "key": "position", "header": "Position", "width": 25 },
    { "key": "posting_lang", "header": "Language of posting", "width": 15 },
    { "key": "doc_lang", "header": "Document language (DE/EN)", "width": 15 },
    { "key": "company", "header": "Company name", "width": 25, "required": true },
    { "key": "industry", "header": "Industry", "width": 15 },
    { "key": "company_size", "header": "Company size", "width": 15 },
    { "key": "website", "header": "Website", "width": 25 },
    { "key": "careers_url", "header": "Careers page URL", "width": 25 },
    { "key": "rating", "header": "Company rating", "width": 15 },
    { "key": "address", "header": "Full address", "width": 30 },
    { "key": "city", "header": "City", "width": 15 },
    { "key": "maps_link", "header": "Google Maps link", "width": 25 },
    { "key": "work_model", "header": "Work model", "width": 15 },
    { "key": "contact_person", "header": "Contact person", "width": 20 },
    { "key": "contact_email", "header": "Contact email", "width": 25 },
    { "key": "phone", "header": "Phone", "width": 15 },
    { "key": "app_method", "header": "Application method", "width": 20 },
    { "key": "app_url", "header": "Application email or portal URL", "width": 30 },
    { "key": "duration", "header": "Duration", "width": 10 },
    { "key": "start_date", "header": "Start date", "width": 12 },
    { "key": "deadline", "header": "Deadline", "width": 12, "format": "date" },
    { "key": "full_part", "header": "Full/part time", "width": 15 },
    { "key": "internship_type", "header": "Internship type", "width": 20 },
    { "key": "paid", "header": "Paid?", "width": 10 },
    { "key": "salary", "header": "Salary amount", "width": 15 },
    { "key": "benefits", "header": "Other benefits", "width": 25 },
    { "key": "req_german", "header": "Required German level", "width": 15 },
    { "key": "req_english", "header": "Required English level", "width": 15 },
    { "key": "req_skills", "header": "Required skills", "width": 30 },
    { "key": "missing_reqs", "header": "Missing requirements", "width": 30 },
    { "key": "visa_req", "header": "Work permit / visa mentioned?", "width": 20 },
    { "key": "match_score", "header": "Match score (0-100)", "width": 15 },
    { "key": "why_match", "header": "Why it matches", "width": 30 },
    { "key": "cv_file", "header": "Tailored CV file", "width": 25 },
    { "key": "cl_file", "header": "Tailored cover letter file", "width": 25 },
    { "key": "status", "header": "Application status", "width": 20, "enum": "statuses" },
    { "key": "date_applied", "header": "Date applied", "width": 12, "format": "date" },
    { "key": "follow_up", "header": "Follow-up date", "width": 12, "format": "date" },
    { "key": "response_date", "header": "Response date", "width": 12, "format": "date" },
    { "key": "interview_date", "header": "Interview date", "width": 12, "format": "date" },
    { "key": "interviewer", "header": "Interviewer / contact name", "width": 20 },
    { "key": "response_summary", "header": "Response summary", "width": 30 },
    { "key": "data_source", "header": "Data source", "width": 20 },
    { "key": "notes", "header": "Notes", "width": 40 }
  ],
  "applyDecisions": [
    { "value": "Yes", "open": true },
    { "value": "No", "open": false },
    { "value": "Maybe", "open": true }
  ],
  "statuses": [
    { "value": "Not applied", "open": true, "meaning": "Decided to apply, but haven't yet." },
    { "value": "Applied", "open": true, "meaning": "Sent." },
    { "value": "Failed", "open": false, "meaning": "Submission failed." },
    { "value": "Blocked", "open": false, "meaning": "Blocked by captcha/login." },
    { "value": "Needs input", "open": true, "meaning": "Requires human intervention." },
    { "value": "Confirmation received", "open": true, "meaning": "Received auto-reply." },
    { "value": "Interview scheduled", "open": true, "meaning": "Invited for interview." },
    { "value": "Interview done", "open": true, "meaning": "Interview completed." },
    { "value": "Offer", "open": true, "meaning": "Received offer." },
    { "value": "Rejected", "open": false, "meaning": "Application rejected." },
    { "value": "No response", "open": false, "meaning": "Ghosted." },
    { "value": "Withdrawn", "open": false, "meaning": "Pulled out." }
  ]
}
